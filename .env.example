# Copy to .env (never commit .env) and adjust. docker compose reads it automatically;
# export the variables in your shell (e.g. `set -a; . ./.env; set +a`) for Django.

# Local PostgreSQL started by docker-compose.yml (development credentials only)
POSTGRES_DB=sr_academy
POSTGRES_USER=sr_academy
POSTGRES_PASSWORD=sr_academy_dev
POSTGRES_PORT=5432

# Django uses DATABASE_URL when set (the tests create test_<dbname> automatically,
# so this role needs CREATEDB, which the postgres image grants to POSTGRES_USER).
DATABASE_URL=postgres://sr_academy:sr_academy_dev@localhost:5432/sr_academy

# Fail the test run if it is not really on PostgreSQL.
REQUIRE_POSTGRES=1

# Development mode (default). Never use these values on a server.
DJANGO_ENV=development
DJANGO_DEBUG=true

# ---------------------------------------------------------------------------
# Production (see docs/DEPLOYMENT.md). Values come from a secret manager, not this file.
# DJANGO_ENV=production
# DJANGO_SECRET_KEY=<64+ random characters>
# DJANGO_ALLOWED_HOSTS=academy.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://academy.example.com
# DATABASE_URL=postgres://sr_app:<password>@db-host:5432/sr_academy
# DATABASE_SSL_REQUIRE=true
# DJANGO_SECURE_PROXY_SSL_HEADER=true
# DJANGO_TRUST_X_FORWARDED_FOR=true

# Web app (frontend/) settings live in frontend/.env.example (all VITE_* values are public).
