# Frontend settings (Vite). Every VITE_* value is compiled into the public
# JavaScript bundle: never put secrets here.

# Base URL of the Django API. Leave empty to use the same origin (recommended:
# the reverse proxy serves /app/ and /api/ from one host).
VITE_API_BASE_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Development only: where `npm run dev` proxies /api/ requests (the Django dev server).
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
