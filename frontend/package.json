{
  "name": "sr-wushu-academy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SR Wushu Academy web app (staff, finance, coach, parent and student portals) for the Django REST API.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
